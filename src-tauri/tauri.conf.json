{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Airobot",
  "version": "0.7.1",
  "identifier": "com.airobot.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://127.0.0.1:8081",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Airobot virtual office",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": {
      "resources/postgres/": "postgres/",
      "../web/dist/": "web/"
    }
  }
}
