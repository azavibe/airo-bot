# Local dev via `docker compose up`: `postgres` runs as a container (gated
# behind the "local" Compose profile, enabled below) using these credentials.
# docker-compose.yml builds the in-container app's DATABASE_URL from them
# automatically, pointed at hostname `postgres`.
#
# To use an existing PostgreSQL server instead, set DATABASE_URL to it and
# remove COMPOSE_PROFILES so the bundled database container never starts.
COMPOSE_PROFILES=local
POSTGRES_DB=airobot
POSTGRES_USER=airobot_user
POSTGRES_PASSWORD=changeme
# Change this when another local project already uses PostgreSQL's default.
POSTGRES_PORT=5432

# Used directly by the app when running outside `docker compose` -- e.g.
# `cargo run` or the `sqlx` CLI against the same dockerized Postgres via its
# published localhost port above.
DATABASE_URL=postgres://airobot_user:changeme@127.0.0.1:5432/airobot

# Port for `cargo run`. Under `docker compose`, the host port is APP_PORT.
PORT=8081
APP_PORT=8080
APP_ENV=development

# One-click email-free sign-in for local development (the SPA's dev button).
# Only @airobot.local / @example.com addresses; refused when APP_ENV=production.
AIR_DEV_LOGIN=1

# Encrypts agents' own OpenRouter keys at rest. Production refuses to start
# without 32+ characters here (e.g. `openssl rand -hex 32`); development falls
# back to a fixed development-only key.
PROVIDER_KEY_SECRET=

# Optional; defaults to "info" if unset.
RUST_LOG=info

# Base URL used to build links sent in email (magic links). No trailing slash.
APP_BASE_URL=http://127.0.0.1:8081

# SMTP for magic-link email. Development logs magic links when this is empty;
# APP_ENV=production refuses to start without a configured SMTP host.
SMTP_HOST=
SMTP_PORT=587
# Only trust forwarded client IPs from these exact reverse-proxy addresses.
# For production, use the current Caddy container IP; empty for direct local use.
TRUSTED_PROXY_IPS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Airobot <noreply@airo-bot.com>

# URL-safe base64, unpadded, raw P-256 private key used for Web Push VAPID.
# Generate once with `openssl rand -base64 32`, convert `+/` to `-_`, and
# remove `=` padding. Production refuses to start without it.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@airo-bot.com

# Platform AI key. Calls made with it are metered against each workspace's
# credit wallet; users' own OpenRouter keys are never metered.
# OPENROUTER_API_KEY=
# Where "Upgrade" sends people who hit a credit limit (https only in production).
# UPGRADE_URL=

# Connections (the Connections screen). Each provider needs an OAuth app
# registered by whoever runs this server; one left empty is listed as "not
# set up". Redirect URI to register: APP_BASE_URL/api/connections/oauth/<provider>/callback
# Google Cloud console: OAuth client (Web), Gmail/Calendar/Sheets APIs enabled.
# (The desktop app uses a separate "Desktop app" client, built in at release
# time from the AIROBOT_GOOGLE_DESKTOP_CLIENT_ID / _SECRET GitHub secrets.)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Stripe Connect (Standard): the ca_ client id and the platform secret key.
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY=
# Shopify Partners app (scopes read_orders,read_products).
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
