# HTTPS for Airobot. Caddy gets and renews the certificate by itself, as
# long as DOMAIN points at this server and ports 80 and 443 are open.

{$DOMAIN} {
	encode zstd gzip

	# Browsers that have seen this once only ever use HTTPS for a year. Not
	# includeSubDomains or preload: other subdomains (mail, docs) may not
	# have HTTPS, and those are hard to undo.
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy app:8080 {
		# Live updates (server-sent events) must not be held back.
		flush_interval -1
		health_uri /health
		health_interval 15s
		# Caddy replaces any X-Forwarded-For a visitor sends with their real
		# address (it trusts no proxy in front of it); the app believes it
		# only from this Caddy.
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
