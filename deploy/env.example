# Copy to .env next to docker-compose.yml and fill it in. Keep it private:
# `chmod 600 .env`, and never commit it.

# The address people use, without https://. Its DNS A record must point at
# this server before the first start (Caddy asks Let's Encrypt for the
# certificate then).
DOMAIN=airo-bot.com

# Which release to run: a version like 0.8.0, or "latest".
AIROBOT_VERSION=latest

# Database password. Choose it once: `openssl rand -hex 24`.
POSTGRES_PASSWORD=

# Encrypts people's own AI keys and connection keys at rest. 32+ characters,
# `openssl rand -hex 32`. NEVER change it once people have saved keys.
PROVIDER_KEY_SECRET=

# Web Push (browser notifications). Generate once:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n'
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@airo-bot.com

# Sign-in links are sent by email, so the server refuses to start without
# a mail service (Resend, Postmark, Amazon SES, your own SMTP...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Airobot <noreply@airo-bot.com>

# Optional: a shared AI for everyone (metered per office), where "Upgrade"
# sends people, and the apps behind Connections. Redirect URI to register at
# each provider: https://<DOMAIN>/api/connections/oauth/<provider>/callback
# OPENROUTER_API_KEY=
# UPGRADE_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# STRIPE_CONNECT_CLIENT_ID=
# STRIPE_SECRET_KEY=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

RUST_LOG=info
