# Build output
dist/
!web/dist/
!web/dist/**
# The ONNX runtime for local voice models (~21 MB) is emitted by every
# build; transformers.js loads it from its CDN at runtime, so it never
# needs to be in git (the Docker build still serves a copy).
web/dist/assets/*.wasm
build/

out/
*.tsbuildinfo

